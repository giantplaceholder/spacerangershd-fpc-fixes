diff --git a/tools/winhost.py b/tools/winhost.py
new file mode 100644
--- /dev/null
+++ b/tools/winhost.py
@@ -0,0 +1,172 @@
+"""Windows host tools. FPC 3.2.2 is only the bootstrap."""
+
+from __future__ import annotations
+
+import hashlib
+import os
+import shutil
+import subprocess
+import zipfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+HOST = ROOT / ".local" / "windows-host"
+
+WINLIBS_URL = (
+    "https://github.com/brechtsanders/winlibs_mingw/releases/download/"
+    "16.2.0posix-14.0.0-ucrt-r2/"
+    "winlibs-x86_64-posix-seh-gcc-16.2.0-mingw-w64ucrt-14.0.0-r2.zip"
+)
+WINLIBS_SHA256 = "d5dbafc4a170e762ca6143151ec918fb9e2c72736fb14cd704abebc6bdd5276a"
+FPC_URL = "https://downloads.freepascal.org/fpc/dist/3.2.2/i386-win32/fpc-3.2.2.win32.and.win64.exe"
+FPC_SHA256 = "8c255390544b051388b577eb61c6191a04883264afe0e3369b3600a56daf7bde"
+
+
+def native() -> bool:
+    return os.name == "nt"
+
+
+def _digest(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _fetch(url: str, dest: Path, expected: str) -> None:
+    import urllib.request
+
+    if dest.is_file() and _digest(dest) == expected:
+        return
+    dest.parent.mkdir(parents=True, exist_ok=True)
+    if dest.is_file():
+        dest.unlink()
+    print(f"Downloading {url}…", flush=True)
+    urllib.request.urlretrieve(url, dest)
+    got = _digest(dest)
+    if got != expected:
+        dest.unlink()
+        raise RuntimeError(f"SHA256 mismatch for {url}: got {got}, expected {expected}")
+
+
+def _which(name: str) -> Path | None:
+    found = shutil.which(name)
+    return Path(found).resolve() if found else None
+
+
+def _prepend(bin_dir: Path) -> None:
+    if bin_dir.is_dir():
+        os.environ["PATH"] = str(bin_dir) + os.pathsep + os.environ.get("PATH", "")
+
+
+def _winlibs_bin() -> Path | None:
+    hits = list(HOST.glob("winlibs/**/gcc.exe"))
+    return hits[0].parent if hits else None
+
+
+def prefix() -> str:
+    if _which("x86_64-w64-mingw32-gcc"):
+        return "x86_64-w64-mingw32-"
+    return ""
+
+
+
+def _existing_ppc386() -> Path | None:
+    found = _which("ppc386")
+    if found is not None:
+        return found
+    for root in (HOST / "fpc", Path("C:/FPC")):
+        if root.exists():
+            hits = list(root.rglob("ppc386.exe"))
+            if hits:
+                return hits[0]
+    return None
+
+
+def ensure_toolchain() -> None:
+    if not native():
+        return
+    if not (_which("gcc") and _which("cmake") and _which("windres")):
+        archive = HOST / "winlibs.zip"
+        _fetch(WINLIBS_URL, archive, WINLIBS_SHA256)
+        if not _winlibs_bin():
+            print("Extracting WinLibs…", flush=True)
+            with zipfile.ZipFile(archive) as zf:
+                zf.extractall(HOST / "winlibs")
+    winlibs = _winlibs_bin()
+    if winlibs is not None:
+        _prepend(winlibs)
+    found = _existing_ppc386()
+    if found is not None:
+        _prepend(found.parent)
+        return
+    installer = HOST / "fpc-3.2.2.win32.and.win64.exe"
+    _fetch(FPC_URL, installer, FPC_SHA256)
+    dest = HOST / "fpc"
+    dest.mkdir(parents=True, exist_ok=True)
+    print(f"Installing FPC 3.2.2 bootstrap into {dest}…", flush=True)
+    subprocess.run(
+        [str(installer), "/VERYSILENT", "/SUPPRESSMSGBOXES", "/NORESTART", "/SP-", f"/DIR={dest}"],
+        check=True,
+    )
+    found = _existing_ppc386()
+    if found is None:
+        raise FileNotFoundError("FPC bootstrap did not install ppc386.exe")
+    _prepend(found.parent)
+    if winlibs is not None:
+        _prepend(winlibs)
+
+
+def tool(name: str) -> Path:
+    ensure_toolchain()
+    found = _which(prefix() + name) or _which(name)
+    if found is None:
+        raise FileNotFoundError(f"Required tool not found: {prefix()}{name}")
+    return found
+
+
+
+def static_runtime() -> str:
+    gcc = tool("gcc")
+    roots = [gcc.parent, gcc.parent.parent, gcc.parent.parent / "x86_64-w64-mingw32"]
+    for root in roots:
+        hits = list(root.rglob("libwinpthread.a"))
+        if hits:
+            return hits[0].as_posix()
+    raise FileNotFoundError("libwinpthread.a was not found next to the MinGW toolchain")
+
+
+def static_pthread_dir() -> str:
+    archive = Path(static_runtime())
+    dest = HOST / "static-pthread"
+    dest.mkdir(parents=True, exist_ok=True)
+    for name in ("libwinpthread.a", "libpthread.a", "libwinpthread.dll.a", "libpthread.dll.a"):
+        target = dest / name
+        if not target.is_file() or target.stat().st_size != archive.stat().st_size:
+            shutil.copy2(archive, target)
+    return dest.as_posix()
+
+
+def rc_compiler() -> str:
+    path = tool("gcc").parent / "windres.exe"
+    if not path.is_file():
+        path = tool("windres")
+    return Path(path).as_posix()
+
+
+def bootstrap_fpc() -> Path:
+    ensure_toolchain()
+    for root in (Path("C:/FPC/3.2.2"), HOST / "fpc"):
+        if root.exists():
+            hits = list(root.rglob("ppc386.exe"))
+            if hits:
+                return hits[0]
+    found = _which("ppc386")
+    if found is None:
+        raise FileNotFoundError("ppc386.exe bootstrap compiler was not found")
+    return found
+
+
+def make() -> Path:
+    ensure_toolchain()
+    found = _which("mingw32-make") or _which("gmake") or _which("make")
+    if found is None:
+        raise FileNotFoundError("GNU Make was not found")
+    return found
