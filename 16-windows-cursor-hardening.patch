+procedure TCursorGI.ShowCursorCounter(Show: Boolean);
+var
+  Steps: Integer;
+begin
+  Steps := 0;
+  if Show then
+  begin
+    while (ShowGameCursor(True) < 0) and (Steps < MaxCursorCounterSteps) do
+      Inc(Steps);
+  end
+  else
+  begin
+    while (ShowGameCursor(False) >= 0) and (Steps < MaxCursorCounterSteps) do
+      Inc(Steps);
+  end;
+end;
+
+{ A GAI sequence table can name a frame that has no handle behind it. }
+function TCursorGI.ServingHandle(FrameInSequence: Integer): Pointer;
+var
+  Index, Candidate: Integer;
+begin
+  Result := nil;
+  if (FrameInSequence >= 0) and (FrameInSequence <= High(FrameIndices)) then
+  begin
+    Candidate := FrameIndices[FrameInSequence];
+    if (Candidate >= 0) and (Candidate <= High(CursorHandles)) then
+      Result := CursorHandles[Candidate];
+  end;
+  if Result = nil then
+    for Index := 0 to High(CursorHandles) do
+      if CursorHandles[Index] <> nil then
+      begin
+        Result := CursorHandles[Index];
+        Break;
+      end;
+end;
+
+procedure TCursorGI.RebuildWithOld(
+    const RequestedPath: WideString;
+    OldHandles: TCursorHandleList
+);
+var
+  Handle: Pointer;
+begin
+  Handle := nil;
+  try
+    Handle := BuildCursorFrames;
+  except
+    on E: Exception do
+      begin
+        LogCursorFailure(RequestedPath, E.Message);
+        Handle := nil;
+      end;
+  end;
+  if Handle = nil then
+    LogCursorFailure(RequestedPath, 'no cursor handle');
+  if Active then
+  begin
+    ShowCursorCounter(True);
+    DisplayAndRelease(Handle, OldHandles);
+    if (Handle <> nil) and (High(FrameIndices) > 0) then
+    begin
+      StopAnimation;
+      AnimationTimer :=
+          MessageLoop.ScheduleCallbackTimer(
+              Max(1, FrameDelays[Min(FrameIndex, High(FrameDelays))]),
+              Max(1, FrameDelays[Min(FrameIndex, High(FrameDelays))]),
+              AdvanceAnimation
+          );
+    end;
+  end
+  else
+  begin
+    if (not OwnsDisplay) or HandOffToSystemArrow then
+      ReleaseHandles(OldHandles);
+  end;
+end;
+
+procedure TCursorGI.SafeRebuildSystemCursor(const RequestedPath: WideString);
+begin
+  try
+    RebuildWithOld(RequestedPath, DetachCursorFrames);
+  except
+    on E: Exception do
+      LogCursorFailure(RequestedPath, E.Message);
+  end;
 end;
 
