diff --git a/native/CMakeLists.txt b/native/CMakeLists.txt
index 25a6c4a..7e8ed3e 100644
--- a/native/CMakeLists.txt
+++ b/native/CMakeLists.txt
@@ -17,3 +17,27 @@ endif()
 if(ANDROID)
   target_link_options(okgf PRIVATE "-Wl,-z,max-page-size=16384")
 endif()
+
+if(WIN32)
+  # libpng's CMake package still INTERFACE-links shared zlib. Drop that and
+  # link the static archives we pass in from tools/build.py.
+  if(TARGET PNG::PNG)
+    set_property(TARGET PNG::PNG PROPERTY INTERFACE_LINK_LIBRARIES "")
+  endif()
+  if(TARGET ZLIB::ZLIB)
+    set_property(TARGET ZLIB::ZLIB PROPERTY IMPORTED_LOCATION "${ZLIB_LIBRARY}")
+    set_property(TARGET ZLIB::ZLIB PROPERTY INTERFACE_LINK_LIBRARIES "")
+  endif()
+  if(ZLIB_LIBRARY)
+    target_link_libraries(okgf PRIVATE "${ZLIB_LIBRARY}")
+    message(STATUS "OKGF static zlib: ${ZLIB_LIBRARY}")
+  endif()
+  if(PNG_LIBRARY)
+    target_link_libraries(okgf PRIVATE "${PNG_LIBRARY}")
+    message(STATUS "OKGF static png: ${PNG_LIBRARY}")
+  endif()
+  if(JPEG_LIBRARY)
+    target_link_libraries(okgf PRIVATE "${JPEG_LIBRARY}")
+    message(STATUS "OKGF static jpeg: ${JPEG_LIBRARY}")
+  endif()
+endif()
