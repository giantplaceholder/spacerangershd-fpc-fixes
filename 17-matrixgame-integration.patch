index 0000000..3e57f51
--- /dev/null
+++ b/platform/GameUtf32.pas
@@ -0,0 +1,126 @@
+unit GameUtf32;
+
+{$MODE DELPHI}
+{$POINTERMATH ON}
+
+// Character bridge with the C++ planetary battle engine. Its wchar_t is 4 bytes
+// on Unix and 2 bytes on Windows, while game strings are UTF-16 everywhere.
+// Self-contained because the vendored RTL ships no utf16enc/utf32enc units.
+
+interface
+
+type
+  // Engine character: matches sizeof(wchar_t) on the target.
+  LongWChar = Cardinal;
+  PLongWChar = ^LongWChar;
+{$IFDEF MSWINDOWS}
+  EngineChar = WideChar;
+  PEngineChar = PWideChar;
+  TEngineCharArray = array of WideChar;
+{$ELSE}
+  EngineChar = LongWChar;
+  PEngineChar = PLongWChar;
+  TEngineCharArray = array of LongWChar;
+{$ENDIF}
+
+// Zero-terminated engine-width copy of Text, always at least one element, so
+// PEngineChar(@Buffer[0]) is valid even for ''. The caller must keep the array
+// alive while the engine can still read it.
+function EngineBuffer(const Text: WideString): TEngineCharArray;
+
+// Inverse. '' for nil.
+function EngineText(Text: PEngineChar): WideString;
+
+implementation
+
+function EngineBuffer(const Text: WideString): TEngineCharArray;
+var
+  Index, Last, Written: Integer;
+  HighSurrogate, LowSurrogate: Cardinal;
+begin
+  Last := Length(Text);
+{$IFDEF MSWINDOWS}
+  SetLength(Result, Last + 1);
+  for Index := 1 to Last do
+    Result[Index - 1] := Text[Index];
+  Result[Last] := WideChar(0);
+{$ELSE}
+  // Room for one code point per UTF-16 unit plus the terminator.
+  SetLength(Result, Last + 1);
+  Written := 0;
+  Index := 1;
+  while Index <= Last do
+  begin
+    HighSurrogate := Ord(Text[Index]);
+    if (HighSurrogate >= $D800) and (HighSurrogate <= $DBFF) and (Index < Last) then
+    begin
+      LowSurrogate := Ord(Text[Index + 1]);
+      if (LowSurrogate >= $DC00) and (LowSurrogate <= $DFFF) then
+      begin
+        Result[Written] := $10000 + (HighSurrogate - $D800) * $400 +
+            (LowSurrogate - $DC00);
+        Inc(Written);
+        Inc(Index, 2);
+        Continue;
+      end;
+    end;
+    Result[Written] := HighSurrogate;
+    Inc(Written);
+    Inc(Index);
+  end;
+  if Written < Last then
+    SetLength(Result, Written + 1);
+  Result[Written] := LongWChar(0);
+{$ENDIF}
+end;
+
+function EngineText(Text: PEngineChar): WideString;
+var
+  Index, Written, Units: Integer;
+  Code: Cardinal;
+begin
+  Result := '';
+  if Text = nil then
+    Exit;
+{$IFDEF MSWINDOWS}
+  Units := 0;
+  while Text[Units] <> WideChar(0) do
+    Inc(Units);
+  SetLength(Result, Units);
+  for Index := 0 to Units - 1 do
+    Result[Index + 1] := Text[Index];
+{$ELSE}
+  Units := 0;
+  Index := 0;
+  while Text[Index] <> 0 do
+  begin
+    if Text[Index] <= $FFFF then
+      Inc(Units)
+    else
+      Inc(Units, 2);
+    Inc(Index);
+  end;
+  SetLength(Result, Units);
+  Written := 0;
+  Index := 0;
+  while (Text[Index] <> 0) and (Written < Units) do
+  begin
+    Code := Text[Index];
+    if Code <= $FFFF then
+    begin
+      Result[Written + 1] := WideChar(Code);
+      Inc(Written);
+    end
+    else
+    begin
+      Dec(Code, $10000);
+      Result[Written + 1] := WideChar($D800 + (Code shr 10));
+      Result[Written + 2] := WideChar($DC00 + (Code and $3FF));
+      Inc(Written, 2);
+    end;
+    Inc(Index);
+  end;
+{$ENDIF}
+end;
+
+end.
