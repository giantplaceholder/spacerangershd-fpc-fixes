+procedure ReleaseGameWindowInput;
+begin
+  // The native battle engine draws in its own window and SDL instance. While
+  // this process holds a grab or a mouse rect, X routes pointer events only to
+  // our window, so the battle window could never be clicked.
+  if GameSDLWindow = nil then
+    Exit;
+  SDL_SetWindowMouseRect(GameSDLWindow, nil);
+  SDL_SetWindowGrab(GameSDLWindow, 0);
+end;
