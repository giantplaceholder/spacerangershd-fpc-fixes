+// Library names the engine is shipped under, most specific first.
+const
+  BattleEngineWinName = 'MatrixGame.dll';
+  BattleEngineUnixName = 'MatrixGame.so';
+
+// Locate and load the battle engine. Windows finds MatrixGame.dll through the
+// loader search path. On Unix FPC does not translate a .dll name into a .so, so
+// the executable's own directory and the current one are spelled out.
+function LoadBattleEngine(const OverrideName: WideString): TLibHandle;
+const
+  MaxNames = 6;
+var
+  Index: Integer;
+  Names: array of WideString;
+
+  function HasPath(const Name: WideString): Boolean;
+  begin
+    Result := (Pos('/', Name) > 0) or (Pos('\', Name) > 0);
+  end;
+
+  procedure AddName(const Candidate: WideString);
+  var
+    Duplicate: Integer;
+  begin
+    if Candidate = '' then
+      Exit;
+    for Duplicate := 0 to High(Names) do
+      if Names[Duplicate] = Candidate then
+        Exit;
+    SetLength(Names, Length(Names) + 1);
+    Names[High(Names)] := Candidate;
+  end;
+
+begin
+  Result := 0;
+  SetLength(Names, 0);
+  if OverrideName <> '' then
+  begin
+    AddName(OverrideName);
+{$IFNDEF MSWINDOWS}
+    // The same override written for a Windows install still resolves here.
+    if HasPath(OverrideName) then
+      AddName(ChangeFileExt(OverrideName, '.so'))
+    else
+      AddName('./' + ChangeFileExt(OverrideName, '.so'));
+{$ENDIF}
+  end
+  else
+  begin
+{$IFDEF MSWINDOWS}
+    AddName(BattleEngineWinName);
+{$ELSE}
+    AddName(ExtractFilePath(ParamStr(0)) + BattleEngineUnixName);
+    AddName('./' + BattleEngineUnixName);
+    // Also accept a soname-style install next to the loader path.
+    AddName('lib' + BattleEngineUnixName);
+{$ENDIF}
+  end;
+  if Length(Names) > MaxNames then
+    SetLength(Names, MaxNames);
+  for Index := 0 to High(Names) do
+  begin
+    Result := LoadLibrary(UTF8Encode(Names[Index]));
+    if Result <> 0 then
+      Exit;
+  end;
+  Result := 0;
+end;
+
