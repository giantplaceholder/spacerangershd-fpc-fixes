+def elf_segments(data: bytes):
+    """Return the PT_LOAD program headers of an ELF64 little-endian object."""
+    e_phoff = struct.unpack_from("<Q", data, 0x20)[0]
+    (e_phentsize, e_phnum) = struct.unpack_from("<2H", data, 0x36)
+    loads = []
+    for index in range(e_phnum):
+        offset = e_phoff + index * e_phentsize
+        if struct.unpack_from("<I", data, offset)[0] != PT_LOAD:
+            continue
+        (p_offset, p_vaddr, _paddr, p_filesz) = struct.unpack_from("<4Q", data, offset + 8)
+        loads.append((p_vaddr, p_offset, p_filesz))
+    return loads
+
+
+def file_offset(loads, vaddr):
+    """Translate a virtual address, as stored in DT_*, into an offset in the file."""
+    if vaddr is None:
+        return None
+    for (seg_vaddr, seg_offset, seg_filesz) in loads:
+        if seg_vaddr <= vaddr < seg_vaddr + seg_filesz:
+            return seg_offset + (vaddr - seg_vaddr)
+    return None
+
+
+def elf_dynamic(data: bytes):
+    """Return (bytes, dynamic entries, strtab file offset) for an ELF64 LE object.
+
+    PT_DYNAMIC is used instead of SHT_DYNAMIC because a stripped object keeps its
+    program headers but may lose the section header table. DT_* string pointers
+    hold *virtual* addresses, so DT_STRTAB is mapped through PT_LOAD before use.
+    """
+    if len(data) < 64 or data[:4] != b"\x7fELF" or data[4] != 2 or data[5] != 1:
+        return None
+    e_phoff = struct.unpack_from("<Q", data, 0x20)[0]
+    (e_phentsize, e_phnum) = struct.unpack_from("<2H", data, 0x36)
+    span = None
+    for index in range(e_phnum):
+        offset = e_phoff + index * e_phentsize
+        if struct.unpack_from("<I", data, offset)[0] != PT_DYNAMIC:
+            continue
+        (p_offset, _vaddr, _paddr, p_filesz) = struct.unpack_from("<4Q", data, offset + 8)
+        if p_filesz >= 16 and p_offset + p_filesz <= len(data):
+            span = (p_offset, p_offset + p_filesz)
+        break
+    if span is None:
+        return None
+    entries = []
+    for pos in range(span[0], span[1] - 15, 16):
+        (tag, value) = struct.unpack_from("<2Q", data, pos)
+        if tag == DT_NULL:
+            break
+        entries.append((pos, tag, value))
+    strtab = next((value for (_pos, tag, value) in entries if tag == DT_STRTAB), None)
+    return (data, entries, file_offset(elf_segments(data), strtab))
+
+
+def elf_string(data: bytes, strtab, offset: int) -> str:
+    begin = strtab + offset
+    if strtab is None or begin >= len(data):
+        return ""
+    end = data.find(b"\0", begin)
+    return "" if end < 0 else data[begin:end].decode("utf-8", "replace")
+
