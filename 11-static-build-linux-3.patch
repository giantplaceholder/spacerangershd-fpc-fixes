+DT_NULL = 0
+DT_STRTAB = 5
+DT_RPATH = 15
+DT_RUNPATH = 29
+PT_LOAD = 1
+PT_DYNAMIC = 2
+ORIGIN = "$ORIGIN"
+DT_NEEDED = 1
+LIBRARY_DIRS = (
+    "/usr/lib/x86_64-linux-gnu",
+    "/lib/x86_64-linux-gnu",
+    "/usr/lib64",
+    "/usr/lib",
+    "/lib64",
+    "/lib",
