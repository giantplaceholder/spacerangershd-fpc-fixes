+def ld_so_index() -> dict:
+    """Map SONAME to path via ldconfig so bundling never depends on ldd."""
+    try:
+        report = subprocess.run(
+            ["ldconfig", "-p"], text=True, stdout=subprocess.PIPE,
+            stderr=subprocess.DEVNULL, check=False,
+        ).stdout
+    except OSError:
+        return {}
+    index = {}
+    for line in report.splitlines():
+        if " => " not in line:
+            continue
+        (left, _, path) = line.partition(" => ")
+        name = left.strip().split() and left.strip().split()[0]
+        if name and name not in index and Path(path.strip()).is_file():
+            index[name] = path.strip()
+    return index
+
+
+def search_paths(info, obj: Path) -> list[Path]:
+    """RPATH/RUNPATH of *obj*, with $ORIGIN expanded, as concrete directories."""
+    paths = []
+    if info is None:
+        return paths
+    (data, entries, strtab) = info
+    for (_pos, tag, value) in entries:
+        if tag not in (DT_RPATH, DT_RUNPATH):
+            continue
+        for entry in elf_string(data, strtab, value).split(":"):
+            if not entry:
+                continue
+            expanded = entry.replace(ORIGIN, str(obj.parent))
+            paths.append(Path(expanded))
+    return paths
+
+
+def bundle_origin_deps(binary: Path, dest: Path) -> None:
+    """Copy every non-glibc DT_NEEDED of *binary*, transitively, into *dest*.
+
+    Dependencies are read straight from the ELF dynamic tables rather than from
+    ldd: ldd resolves against the *host*, so on a host that is missing a library
+    it reports "not found" and the walk silently stops. Resolving DT_NEEDED
+    ourselves keeps the bundle complete wherever it is produced.
+    """
+    index = ld_so_index()
+    seen, missing, queue = set(), [], [binary]
+    # Directories where shipped libraries were found; needed because a library
+    # may keep a dependency in its own directory without naming it in an RPATH.
+    found_dirs: list[Path] = [binary.parent]
+    while queue:
+        current = queue.pop()
+        info = elf_dynamic(current.read_bytes()) if current.is_file() else None
+        if info is None:
+            continue
+        (data, entries, strtab) = info
+        own = [*search_paths(info, current), *found_dirs]
+        for (_pos, tag, value) in entries:
+            if tag != DT_NEEDED:
+                continue
+            name = elf_string(data, strtab, value)
+            if not name or name in seen or name in GLIBC_PROVIDED:
+                continue
+            candidates = [dest / name, *[path / name for path in own], *[
+                Path(directory) / name for directory in LIBRARY_DIRS
+            ]]
+            if name in index:
+                candidates.append(Path(index[name]))
+            source = next((path for path in candidates if path.is_file()), None)
+            if source is None:
+                missing.append(name)
+                continue
+            seen.add(name)
+            if source.parent not in found_dirs:
+                found_dirs.append(source.parent)
+            target = dest / source.name
+            if target.resolve() != source.resolve():
+                shutil.copy2(source, target)
+            queue.append(target)
+    if missing:
+        print("Warning: unresolved dependencies while bundling: " + ", ".join(sorted(set(missing))))
+
