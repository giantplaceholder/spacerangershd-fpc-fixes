+def make_origin_relocatable(libraries: Path) -> None:
+    """Make *libraries* relocatable without patchelf, using legacy DT_RPATH.
+
+    Two rewrites, both size-preserving so no object is resized or relaid out:
+
+    1. DT_RUNPATH -> DT_RPATH. RUNPATH is consulted only for the object that
+       carries it, so SDL2's transitive dependencies fall back to the host cache.
+       Legacy RPATH accumulates down the whole tree, which is what a
+       self-contained bundle needs.
+    2. An absolute DT_RPATH is rewritten to $ORIGIN when every non-glibc
+       DT_NEEDED of that object is already bundled. glibc searches an object's
+       own RPATH before any inherited one, so libpulse's hard-coded
+       /usr/lib/x86_64-linux-gnu/pulseaudio otherwise wins and pulls
+       libpulsecommon, a private library absent from the ld.so cache, off the
+       host. Rewriting (always a shortening, so in place is safe) makes bin/ the
+       only search directory.
+
+    Objects whose dependencies are not all bundled are left untouched and
+    reported, so the bundle stays loadable rather than being made shorter.
+    """
+    objects = [libraries / "Rangers", *sorted(
+        path for path in libraries.glob("*.so*") if path.is_file() and not path.is_symlink()
+    )]
+    bundled = {path.name for path in libraries.iterdir() if path.is_file()}
+    flipped, rewritten, problems = [], [], []
+    for path in objects:
+        if not path.is_file():
+            continue
+        info = elf_dynamic(path.read_bytes())
+        if info is None:
+            continue
+        (data, entries, strtab) = info
+        rpath = [item for item in entries if item[1] == DT_RPATH]
+        runpath = [item for item in entries if item[1] == DT_RUNPATH]
+        # With both tags present glibc uses DT_RUNPATH for this object's own
+        # imports and still inherits DT_RPATH, so only a lone DT_RUNPATH hurts.
+        if runpath and not rpath:
+            buffer = bytearray(data)
+            struct.pack_into("<Q", buffer, runpath[0][0], DT_RPATH)
+            path.write_bytes(bytes(buffer))
+            flipped.append(path.name)
+            data, rpath = bytes(buffer), [runpath[0]]
+        if path.name == "Rangers" and not any(
+            elf_string(data, strtab, value) == ORIGIN for (_pos, _tag, value) in rpath
+        ):
+            problems.append("Rangers has no DT_RPATH=$ORIGIN; the bundle is not relocatable")
+        for (pos, _tag, value) in rpath:
+            current = elf_string(data, strtab, value)
+            if current == ORIGIN or not current.startswith("/"):
+                continue
+            wanted = [
+                elf_string(data, strtab, val)
+                for (_pos, tag, val) in entries
+                if tag == DT_NEEDED and elf_string(data, strtab, val) not in GLIBC_PROVIDED
+            ]
+            if any(name not in bundled for name in wanted):
+                problems.append(f"{path.name}: keeps RPATH {current!r} (deps not bundled)")
+                continue
+            # In-place is safe only for a shortening write that no other entry shares.
+            if len(current) < len(ORIGIN) or any(
+                item[2] == value and item[0] != pos for item in entries
+            ):
+                problems.append(f"{path.name}: cannot rewrite RPATH {current!r}")
+                continue
+            buffer = bytearray(data)
+            begin = strtab + value
+            # Padding to the original width is essential: assigning a shorter
+            # slice to a bytearray deletes bytes and silently truncates the ELF.
+            payload = ORIGIN.encode()
+            buffer[begin:begin + len(current) + 1] = payload + b"\0" * (len(current) + 1 - len(payload))
+            if len(buffer) != len(data):
+                problems.append(f"{path.name}: refused RPATH rewrite (size would change)")
+                continue
+            path.write_bytes(bytes(buffer))
+            rewritten.append(f"{path.name}: {current} -> {ORIGIN}")
+    if flipped:
+        print(f"Converted DT_RUNPATH to inherited DT_RPATH for {len(flipped)} object(s).")
+    for line in rewritten:
+        print(f"Retargeted RPATH: {line}")
+    if problems:
+        print("Warning: bundle may not be fully relocatable:")
+        for line in sorted(set(problems)):
+            print(f"  {line}")
+
