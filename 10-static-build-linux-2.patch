+def install_static_ld_wrapper(work: Path, libraries: Path) -> Path:
+    """Put a fake ld first on PATH so we can inject static ogg/vorbis archives."""
+    wrap = work / "ld-wrap"
+    wrap.mkdir(parents=True, exist_ok=True)
+    script = wrap / "ld.bfd"
+    archives = " ".join(
+        f'"{libraries / name}"'
+        for name in ("libvorbisfile.a", "libvorbisenc.a", "libvorbis.a", "libogg.a")
+    )
+    script.write_text(
+        "#!/bin/sh\n"
+        "set -e\n"
+        f'REAL="${{SRHD_REAL_LD:-/usr/bin/ld.bfd}}"\n'
+        f'LOG="{work / "ld-wrap.log"}"\n'
+        'echo "$@" >> "$LOG"\n'
+        "out=\n"
+        "for arg in \"$@\"; do\n"
+        '  case "$arg" in\n'
+        "    -lvorbis|-lvorbisfile|-lvorbisenc|-logg) continue ;;\n"
+        "    *.res)\n"
+        '      if [ -f "$arg" ]; then\n'
+        "        sed -i -e '/^-lvorbis$/d' -e '/^-lvorbisfile$/d' -e '/^-lvorbisenc$/d' -e '/^-logg$/d' \"$arg\"\n"
+        "      fi\n"
+        '      out="$out $arg"\n'
+        "      continue\n"
+        "      ;;\n"
+        "  esac\n"
+        '  out="$out $arg"\n'
+        "done\n"
+        f'exec "$REAL" $out {archives}\n'
+    )
+    script.chmod(0o755)
+    (wrap / "ld").write_text("#!/bin/sh\nexec \"$(dirname \"$0\")/ld.bfd\" \"$@\"\n")
+    (wrap / "ld").chmod(0o755)
+    return wrap
+
