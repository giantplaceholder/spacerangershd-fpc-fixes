+def build_linux_pic_image_deps(work: Path) -> Path:
+    """Host static zlib/png/jpeg with -fPIC so they can go inside libokgf.so."""
+    import tarfile, urllib.request
+    prefix_dir = work / "linux-pic-deps"
+    stamp = prefix_dir / ".stamp"
+    if stamp.is_file() and stamp.read_text().strip() == "pic-3" and (prefix_dir / "lib").is_dir():
+        return prefix_dir
+    prefix_dir.mkdir(parents=True, exist_ok=True)
+    src_root = work / "linux-pic-deps-src"
+    src_root.mkdir(parents=True, exist_ok=True)
+
+    def run(cmd):
+        subprocess.run([str(c) for c in cmd], check=True)
+
+    def cmake_build(src: Path, extra: list[str]):
+        build = src / "build-pic"
+        run([
+            "cmake", "-S", src, "-B", build,
+            f"-DCMAKE_INSTALL_PREFIX={prefix_dir}",
+            "-DCMAKE_BUILD_TYPE=Release",
+            "-DCMAKE_POSITION_INDEPENDENT_CODE=ON",
+            "-DBUILD_SHARED_LIBS=OFF",
+            *extra,
+        ])
+        run(["cmake", "--build", build, "-j1"])
+        run(["cmake", "--install", build])
+
+    zver, pver, jver = "1.3.1", "1.6.43", "3.0.3"
+    zdir = src_root / f"zlib-{zver}"
+    if not zdir.is_dir():
+        za = src_root / f"zlib-{zver}.tar.gz"
+        if not za.is_file():
+            print(f"Downloading zlib {zver}…", flush=True)
+            urllib.request.urlretrieve(
+                f"https://github.com/madler/zlib/releases/download/v{zver}/zlib-{zver}.tar.gz", za
+            )
+        with tarfile.open(za) as tf:
+            tf.extractall(src_root)
+    cmake_build(zdir, [])
+    pdir = src_root / f"libpng-{pver}"
+    if not pdir.is_dir():
+        pa = src_root / f"libpng-{pver}.tar.gz"
+        if not pa.is_file():
+            print(f"Downloading libpng {pver}…", flush=True)
+            urllib.request.urlretrieve(f"https://download.sourceforge.net/libpng/libpng-{pver}.tar.gz", pa)
+        with tarfile.open(pa) as tf:
+            tf.extractall(src_root)
+    cmake_build(pdir, [
+        f"-DCMAKE_PREFIX_PATH={prefix_dir}",
+        "-DPNG_SHARED=OFF",
+        "-DPNG_STATIC=ON",
+        "-DPNG_TESTS=OFF",
+    ])
+    jdir = src_root / f"libjpeg-turbo-{jver}"
+    if not jdir.is_dir():
+        ja = src_root / f"libjpeg-turbo-{jver}.tar.gz"
+        if not ja.is_file():
+            print(f"Downloading libjpeg-turbo {jver}…", flush=True)
+            urllib.request.urlretrieve(
+                f"https://github.com/libjpeg-turbo/libjpeg-turbo/releases/download/{jver}/libjpeg-turbo-{jver}.tar.gz",
+                ja,
+            )
+        with tarfile.open(ja) as tf:
+            tf.extractall(src_root)
+    cmake_build(jdir, ["-DENABLE_SHARED=OFF", "-DENABLE_STATIC=ON"])
+    stamp.write_text("pic-3")
+    return prefix_dir
+
