+def linux_system_archive(*names: str) -> Path:
+    roots = (
+        Path("/usr/lib/x86_64-linux-gnu"),
+        Path("/usr/lib64"),
+        Path("/usr/lib"),
+    )
+    for name in names:
+        for root in roots:
+            cand = root / name
+            if cand.is_file():
+                return cand
+    raise FileNotFoundError("Missing static archive " + ", ".join(names))
+
+
+def linux_system_shared(*names: str) -> Path:
+    roots = (
+        Path("/usr/lib/x86_64-linux-gnu"),
+        Path("/usr/lib64"),
+        Path("/usr/lib"),
+    )
+    for name in names:
+        for root in roots:
+            cand = root / name
+            if cand.is_file() or cand.is_symlink():
+                return cand.resolve()
+    raise FileNotFoundError("Missing shared library " + ", ".join(names))
+
