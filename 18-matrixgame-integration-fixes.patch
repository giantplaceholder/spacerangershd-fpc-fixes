+procedure RestoreGameWindowAfterBattle;
+var
+  Flags: Cardinal;
+begin
+  // battle cleared the mouse rect, put our window back before the reset
+  if GameSDLWindow = nil then
+    Exit;
+  SDL_ShowWindow(GameSDLWindow);
+  SDL_RestoreWindow(GameSDLWindow);
+  SDL_RaiseWindow(GameSDLWindow);
+  Flags := 0;
+  if not GameWindowed then
+    Flags := SDL_WINDOW_FULLSCREEN_DESKTOP;
+  SDL_SetWindowFullscreen(GameSDLWindow, Flags);
+  ConfineGameMouse;
+end;
