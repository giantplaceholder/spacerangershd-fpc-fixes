+def build_windows(release: bool, rebuild: bool = False) -> Path:
+    require_tool('cmake')
+    prefix = 'x86_64-w64-mingw32-'
+    for tool in ('gcc', 'g++', 'ld', 'strip', 'ar'):
+        if shutil.which(prefix + tool) is None:
+            raise FileNotFoundError(f'Missing {prefix}{tool}; install mingw-w64.')
+    work = desktop_directory(ROOT, 'windows', release)
+    libraries, units = (work / name for name in ('bin', 'units'))
+    for directory in (libraries, units):
+        directory.mkdir(parents=True, exist_ok=True)
+    mingw_gcc = Path(shutil.which(prefix + 'gcc'))
+    implib = work / 'lib'
+    implib.mkdir(parents=True, exist_ok=True)
+    deps = build_mingw_image_deps(work)
+    ov = build_mingw_ogg_vorbis(work)
+    windres = shutil.which(prefix + 'windres') or str(mingw_gcc)
+    libdir = deps / 'lib'
+    def first_a(*names):
+        for n in names:
+            cand = libdir / n
+            if cand.is_file():
+                return cand
+        for n in names:
+            hits = list(libdir.glob(n))
+            if hits:
+                return hits[0]
+        return None
+    zlib_a = first_a('libz.a', 'libzlibstatic.a', 'libzlib.a')
+    png_a = first_a('libpng16.a', 'libpng.a', 'libpng16_static.a')
+    jpeg_a = first_a('libjpeg.a', 'libturbojpeg.a')
+    if zlib_a is None:
+        raise FileNotFoundError(f'Static zlib archive not found under {libdir}')
+    # ld splits -L on spaces; keep link inputs on a path without parentheses.
+    link_dir = mingw_safe_dir(work) / "link"
+    link_dir.mkdir(parents=True, exist_ok=True)
+    if zlib_a.is_file():
