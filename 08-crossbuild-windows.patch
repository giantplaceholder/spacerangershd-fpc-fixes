+    host_compiler, _host_flags = prepare_compiler("linux", run_step, llvm=False, lto=False)
+    make = shutil.which("gmake") or shutil.which("make")
+    if make is None:
+        raise FileNotFoundError("Install GNU Make to build the win64 runtime.")
+    prefix = "x86_64-w64-mingw32-"
+    for tool in ("gcc", "ld", "as", "ar", "strip"):
+        if shutil.which(prefix + tool) is None:
+            raise FileNotFoundError(
+                f"Missing {prefix}{tool}; install mingw-w64 (gcc-mingw-w64-x86-64)."
+            )
+    cross_bin = Path(shutil.which(prefix + "ld")).parent
+    host_cpu = linux_cpu()
+    source = WORK / f"{host_cpu}-linux" / "source"
+    if not (source / "rtl").is_dir():
+        raise FileNotFoundError(f"Expected vendored compiler tree at {source}")
+    work = WORK / "x86_64-win64"
+    runtime = work / "runtime" / "x86_64-win64"
+    runtime_source = runtime / "src"
+    units = runtime_source / "rtl" / "units" / "x86_64-win64"
+    revision = source_revision()
+    options = ["-n", "-O2"]
+    target_flags = [
+        "CPU_TARGET=x86_64",
+        "OS_TARGET=win64",
+        f"BINUTILSPREFIX={prefix}",
+        f"CROSSBINDIR={cross_bin}",
+    ]
+    stamp = runtime / "runtime.stamp"
+    runtime_revision = revision + repr((options, target_flags))
+    if not (units / "system.ppu").is_file() or not matches(stamp, runtime_revision):
+        runtime.mkdir(parents=True, exist_ok=True)
+        stamp.unlink(missing_ok=True)
+        if runtime_source.exists():
+            shutil.rmtree(runtime_source)
+        shutil.copytree(
+            source / "rtl", runtime_source / "rtl", ignore=shutil.ignore_patterns("units")
+        )
+        for name in ("compiler", "packages"):
+            dest = runtime_source / name
+            if not dest.exists():
