+        pkg_root / "fcl-image/src",
+        pkg_root / "pasjpeg/src",
+        pkg_root / "fcl-process/src",
+        pkg_root / "fcl-registry/src",
+        pkg_root / "winunits-base/src",
+        pkg_root / "hash/src",
