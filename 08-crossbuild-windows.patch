+def mingw_safe_dir(path: Path) -> Path:
+    """CMake/windres Makefiles break on spaces and parentheses in the path."""
+    text = str(path)
+    if not any(ch in text for ch in " ()[]{}&;!$`"):
+        return path
+    alt = Path("/tmp") / ("srhd-mingw-" + hashlib.sha1(text.encode()).hexdigest()[:12])
+    alt.mkdir(parents=True, exist_ok=True)
+    print(f"Using scratch dir {alt} (path contains shell-special characters)", flush=True)
+    return alt
+
