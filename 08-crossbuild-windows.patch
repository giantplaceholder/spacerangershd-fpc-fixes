+def build_mingw_ogg_vorbis(work: Path) -> Path:
+    import re
+    """Build libogg + libvorbis for MinGW; install DLLs under names FPC expects.
+
+    FPC packages/oggvorbis on Windows use DYNLINK with:
+      ogglib.dll, vorbis.dll, vorbisfile.dll, vorbisenc.dll
+    """
+    import tarfile
+    import urllib.request
+
+    prefix_dir = work / "mingw-oggvorbis"
+    stamp = prefix_dir / ".stamp"
+    need = ("ogg.dll", "libvorbis.dll", "vorbisfile.dll")
+    if stamp.is_file() and stamp.read_text().strip() == "shared-8" and all((prefix_dir / "bin" / n).is_file() for n in need):
+        return prefix_dir
+    gcc = require_tool("x86_64-w64-mingw32-gcc")
+    prefix_dir.mkdir(parents=True, exist_ok=True)
+    src_root = mingw_safe_dir(work) / "mingw-oggvorbis-src"
+    src_root.mkdir(parents=True, exist_ok=True)
+    bin_dir = prefix_dir / "bin"
+    lib_dir = prefix_dir / "lib"
+    bin_dir.mkdir(parents=True, exist_ok=True)
+    lib_dir.mkdir(parents=True, exist_ok=True)
+
+    def run(cmd, cwd):
+        subprocess.run([str(c) for c in cmd], cwd=cwd, check=True)
+
+    # libogg
+    over = "1.3.5"
+    odir = src_root / f"libogg-{over}"
+    if not odir.is_dir():
+        oa = src_root / f"libogg-{over}.tar.gz"
+        if not oa.is_file():
+            print(f"Downloading libogg {over}…", flush=True)
+            urllib.request.urlretrieve(
+                f"https://downloads.xiph.org/releases/ogg/libogg-{over}.tar.gz", oa
+            )
+        with tarfile.open(oa) as tf:
+            tf.extractall(src_root)
+    gxx = require_tool("x86_64-w64-mingw32-g++")
+    windres = shutil.which("x86_64-w64-mingw32-windres") or str(gcc)
+    cross = [
+        "-DCMAKE_SYSTEM_NAME=Windows",
+        "-DCMAKE_SYSTEM_PROCESSOR=x86_64",
+        f"-DCMAKE_C_COMPILER={gcc}",
+        f"-DCMAKE_CXX_COMPILER={gxx}",
+        f"-DCMAKE_RC_COMPILER={windres}",
+        f"-DCMAKE_ASM_COMPILER={gcc}",
+        "-DCMAKE_TRY_COMPILE_TARGET_TYPE=STATIC_LIBRARY",
+    ]
+    run([
+        "cmake", "-S", str(odir), "-B", str(odir / "build"),
+        *cross,
+        f"-DCMAKE_INSTALL_PREFIX={prefix_dir}",
+        "-DCMAKE_BUILD_TYPE=Release",
+        "-DBUILD_SHARED_LIBS=ON",
+        "-DCMAKE_SHARED_LIBRARY_PREFIX=",
+        "-DINSTALL_DOCS=OFF",
+    ], src_root)
+    run(["cmake", "--build", str(odir / "build"), "-j1"], src_root)
+    run(["cmake", "--install", str(odir / "build")], src_root)
+
+    # libvorbis
+    vver = "1.3.7"
+    vdir = src_root / f"libvorbis-{vver}"
+    if not vdir.is_dir():
+        va = src_root / f"libvorbis-{vver}.tar.gz"
+        if not va.is_file():
+            print(f"Downloading libvorbis {vver}…", flush=True)
+            urllib.request.urlretrieve(
+                f"https://downloads.xiph.org/releases/vorbis/libvorbis-{vver}.tar.gz", va
+            )
+        with tarfile.open(va) as tf:
+            tf.extractall(src_root)
+    # MinGW ld rejects MSVC-style win32/*.def (syntax error). Drop them and
+    # export symbols via --export-all-symbols instead.
+    for def_file in (vdir / "win32").glob("*.def") if (vdir / "win32").is_dir() else []:
+        def_file.unlink()
+        print(f"Removed {def_file.name} (incompatible with MinGW ld)", flush=True)
+    for cmake_list in vdir.rglob("CMakeLists.txt"):
+        text = cmake_list.read_text(errors="replace")
+        patched = re.sub(
+            r"[^\n]*win32/vorbis(enc|file)?\.def[^\n]*\n?",
+            "",
+            text,
+        )
+        patched = re.sub(
+            r"[^\n]*vorbis(enc|file)?\.def[^\n]*\n?",
+            "",
+            patched,
+        )
+        if patched != text:
+            cmake_list.write_text(patched)
+            print(f"Patched {cmake_list.relative_to(vdir)} to drop .def sources", flush=True)
+    cross_vorbis = list(cross) + [
+        "-DCMAKE_SHARED_LINKER_FLAGS=-Wl,--export-all-symbols",
+    ]
+    run([
+        "cmake", "-S", str(vdir), "-B", str(vdir / "build"),
+        *cross_vorbis,
+        f"-DCMAKE_INSTALL_PREFIX={prefix_dir}",
+        f"-DCMAKE_PREFIX_PATH={prefix_dir}",
+        "-DCMAKE_BUILD_TYPE=Release",
+        "-DBUILD_SHARED_LIBS=ON",
+        "-DCMAKE_SHARED_LIBRARY_PREFIX=",
+    ], src_root)
+    run(["cmake", "--build", str(vdir / "build"), "-j1"], src_root)
+    run(["cmake", "--install", str(vdir / "build")], src_root)
+
+    # names those files. Do not ship lib*.dll copies.
+    produced = {}
+    for folder in (bin_dir, lib_dir, prefix_dir):
+        if folder.is_dir():
+            for dll in folder.rglob("*.dll"):
+                produced[dll.name.lower()] = dll
+    # Rangers.exe -> vorbisfile.dll -> libvorbis.dll -> ogg.dll
+    canon = {
+        "ogg.dll": ("ogg.dll", "libogg.dll", "libogg-0.dll", "ogglib.dll"),
+        "libvorbis.dll": ("libvorbis.dll", "libvorbis-0.dll", "vorbis.dll"),
+        "vorbisfile.dll": ("vorbisfile.dll", "libvorbisfile.dll", "libvorbisfile-3.dll"),
+    }
+    for dest_name, names in canon.items():
+        src = next((produced[n] for n in names if n in produced), None)
+        if src is None:
+            raise FileNotFoundError(
+                f"No DLL to ship as {dest_name}; have: " + ", ".join(sorted(produced))
+            )
+        dest = bin_dir / dest_name
+        if dest.resolve() != src.resolve():
+            shutil.copy2(src, dest)
+        for extra in names:
+            if extra == dest_name:
+                continue
+            junk = bin_dir / extra
+            if junk.is_file() and junk.resolve() != dest.resolve():
+                junk.unlink()
+    stamp.write_text("shared-8")
+    return prefix_dir
+
