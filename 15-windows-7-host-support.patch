 FPC_SHA256 = "8c255390544b051388b577eb61c6191a04883264afe0e3369b3600a56daf7bde"
 
 
+def cmake_arg(value) -> str:
+    """CMake < 3.29 reads a backslash in a cache value as an escape; use slashes."""
+    return str(value).replace("\\", "/")
+
+
+def is_cmake(command) -> bool:
+    """Whether a command line runs CMake."""
+    if not len(command):
+        return False
+    program = str(command[0]).replace("\\", "/").rpartition("/")[2].lower()
+    return program in ("cmake", "cmake.exe")
+
+
+CONFIGURE_ATTEMPTS = 12
+
+
+def configure_progress(text: str) -> int:
+    """Count completed checks in a configure transcript."""
+    completed = 0
+    for line in text.splitlines():
+        stripped = line.strip()
+        if stripped.startswith("--") and any(
+            stripped.endswith(marker)
+            for marker in (" - done", " - found", " - failed", " - Success", " - Works")
+        ):
+            completed += 1
+    return completed
+
+
+def is_configure(argv) -> bool:
+    """Whether the command configures a tree, as opposed to --build/--install."""
+    argv = [str(argument) for argument in argv]
+    return is_cmake(argv) and "-S" in argv and "-B" in argv
+
+
+def _answered(program: Path) -> bool:
+    """Whether ``program --version`` produced output, without raising."""
+    try:
+        result = subprocess.run(
+            [str(program), "--version"],
+            capture_output=True,
+            text=True,
+            timeout=120,
+        )
+    except (OSError, subprocess.SubprocessError):
+        return False
+    return bool((result.stdout or "").strip())
+
+
+def warm_up(force: bool = False) -> None:
+    """Launch the tools once, so first-use launch failures are not paid by a configure."""
+    global _warmed
+    if not native() or (_warmed and not force):
+        return
+    _warmed = True
+    for name in ("cmake.exe", "ninja.exe", "mingw32-make.exe", "gcc.exe"):
+        program = _winlibs_tool(name)
+        if program is None:
+            continue
+        for attempt in range(3):
+            if _answered(program):
+                break
+            if attempt == 2:
+                print(f"Warning: {program} has not answered a version query yet", flush=True)
+            time.sleep(1)
+
+
+def empty_build_tool_probe(text: str) -> bool:
+    """Whether CMake reported a blank tool version, ie a launch that answered nothing."""
+    if not native() or not text:
+        return False
+    return (
+        "The detected version of Ninja ()" in text
+        or "The detected version of make ()" in text
+    )
+
+
+def cmake_command(command) -> list[str]:
+    """Stringify a command line, normalising the -D values and -S/-B that CMake caches."""
+    argv = [str(argument) for argument in command]
+    if not is_cmake(argv):
+        return argv
+    result = []
+    normalise_next = False
+    for index, argument in enumerate(argv):
+        if normalise_next:
+            result.append(cmake_arg(argument))
+            normalise_next = False
+            continue
+        if argument in ("-S", "-B") and index + 1 < len(argv):
+            result.append(argument)
+            normalise_next = True
+            continue
+        if argument.startswith("-D") and "=" in argument:
+            name, _, value = argument[2:].partition("=")
+            result.append("-D" + name + "=" + cmake_arg(value))
+            continue
+        result.append(argument)
+    return result
+
+
 def native() -> bool:
     return os.name == "nt"
 
