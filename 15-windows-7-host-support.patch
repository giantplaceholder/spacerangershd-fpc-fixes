+def build_tool() -> tuple[str, Path]:
+    """Generator and its absolute program, named so CMake cannot find them on PATH.
+
+    SRHD_WINDOWS_GENERATOR switches ninja to make: ninja is probed before every
+    try_compile, so a blank answer stops a configure, while make is never probed.
+    """
+    ensure_toolchain()
+    wanted = os.environ.get("SRHD_WINDOWS_GENERATOR", "ninja").strip().lower()
+    if wanted not in GENERATORS:
+        raise ValueError(
+            f"SRHD_WINDOWS_GENERATOR={wanted!r}; expected one of "
+            + ", ".join(sorted(GENERATORS))
+        )
+    order = [wanted] if wanted != "ninja" else ["ninja", "make"]
+    for key in order:
+        generator, names = GENERATORS[key]
+        program = _winlibs_tool(*names)
+        if program is not None:
+            return (generator, program)
+    raise FileNotFoundError(
+        f"Neither ninja nor mingw32-make was found inside the WinLibs tree at "
+        f"{HOST / 'winlibs'}. Delete that directory to re-provision it."
+    )
