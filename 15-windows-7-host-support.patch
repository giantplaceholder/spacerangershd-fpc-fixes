+def _winlibs_tool(*names: str) -> Path | None:
+    """Resolve a tool in the provisioned bin directory, never on PATH."""
+    bin_dir = _winlibs_bin()
+    if bin_dir is None:
+        return None
+    for name in names:
+        candidate = bin_dir / name
+        if candidate.is_file():
+            return candidate.resolve()
+    return None
