+def run_checked(command, cwd=None, log=None, echo=True) -> None:
+    """Run a CMake command, retrying a configure that a blank tool version aborted.
+
+    CMake caches completed checks, so each attempt gets further; retry only while
+    it does. A real compile or link error fails at once.
+    """
+    argv = winhost.cmake_command(command)
+    configure = winhost.is_configure(argv)
+    if not configure and log is None:
+        subprocess.run(argv, cwd=cwd, check=True)  # nothing to retry
+        return
+    destination = Path(log) if log is not None else configure_log_path(argv, cwd)
+    attempts = winhost.CONFIGURE_ATTEMPTS if configure else 1
+    status = 0
+    previous = -1
+    for attempt in range(attempts):
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        with destination.open("w") as stream:
+            process = subprocess.Popen(
+                argv,
+                cwd=cwd,
+                stdout=subprocess.PIPE,
+                stderr=subprocess.STDOUT,
+                text=True,
+                errors="replace",
+            )
+            collected = []
+            for line in process.stdout:
+                if echo:
+                    print(line, end="", flush=True)
+                stream.write(line)
+                stream.flush()
+                collected.append(line)
+            status = process.wait()
+        if status == 0:
+            return
+        text = "".join(collected)
+        if not configure or not winhost.empty_build_tool_probe(text):
+            raise subprocess.CalledProcessError(status, argv)
+        reached = winhost.configure_progress(text)
+        if reached <= previous:  # no cached progress gained
+            print(f"Configure made no further progress ({reached} checks)", flush=True)
+            break
+        previous = reached
+        print(
+            f"Build tool probe returned no version, retrying configure "
+            f"(attempt {attempt + 2}, {reached} checks completed)",
+            flush=True,
+        )
+        time.sleep(min(2 * (attempt + 1), 10))
+        winhost.warm_up(force=True)
+    raise subprocess.CalledProcessError(status, argv)
+
