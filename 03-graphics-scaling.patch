+procedure ConfineGameMouse;
+var
+  Bounds: TSDL_Rect;
+  WW, WH: Integer;
+begin
+  if GameSDLWindow = nil then
+    Exit;
+  if GameWindowed then
+  begin
+    SDL_SetWindowMouseRect(GameSDLWindow, nil);
+    Exit;
+  end;
+  if (LogicalWidth <= 0) or (LogicalHeight <= 0) then
+    Exit;
+  SDL_GetWindowSize(GameSDLWindow, WW, WH);
+  Bounds.X := 0;
+  Bounds.Y := 0;
+  Bounds.W := WW;
+  Bounds.H := WH;
+  if Bounds.W < 1 then
+    Bounds.W := LogicalWidth;
+  if Bounds.H < 1 then
+    Bounds.H := LogicalHeight;
+  SDL_SetWindowMouseRect(GameSDLWindow, @Bounds);
 end;
 
