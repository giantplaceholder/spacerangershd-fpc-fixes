+def build_windows_deps_dll(work: Path, libraries: Path) -> Path:
+    """One MinGW-runtime DLL: libgcc + libstdc++ + winpthread + libssp.
+
+    Rangers.exe and okgf.dll link this instead of shipping four separate runtimes.
+    """
+    implib_dir = work / "lib"
+    implib_dir.mkdir(parents=True, exist_ok=True)
+    src = work / "windows_deps.c"
+    src.write_text(
+        "int windows_deps_present(void) { return 1; }\n"
+    )
+    gcc = require_tool("x86_64-w64-mingw32-gcc")
+    gxx = require_tool("x86_64-w64-mingw32-g++")
+    out = libraries / "windows_deps.dll"
+    implib = implib_dir / "libwindows_deps.dll.a"
+    cmd = [
+        str(gxx), "-shared", "-o", str(out), str(src),
+        "-static-libgcc", "-static-libstdc++",
+        "-Wl,-Bstatic", "-lwinpthread", "-lssp", "-Wl,-Bdynamic",
+        f"-Wl,--out-implib,{implib}",
+    ]
+    print("Building windows_deps.dll…", flush=True)
+    subprocess.run(cmd, check=True)
+    if not out.is_file():
+        raise FileNotFoundError(out)
+    return out
+
