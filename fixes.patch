+def prepare_static_oggvorbis_units(work: Path) -> Path:
+    """Copy FPC ogg/vorbis headers with DYNLINK disabled so they $LINKLIB static .a files."""
+    src = ROOT / "vendor/fpc/packages/oggvorbis/src"
+    dest = work / "oggvorbis-static-units"
+    dest.mkdir(parents=True, exist_ok=True)
+    for name in ("ogg.pas", "vorbis.pas"):
+        text = (src / name).read_text(errors="replace")
+        text = text.replace(
+            "{$IFDEF WINDOWS}\n  {$DEFINE DYNLINK}\n{$ENDIF}",
+            "{ Windows: static-link MinGW libogg/libvorbis instead of DLLs }",
+        )
+        # also catch slightly different whitespace
+        if "{$DEFINE DYNLINK}" in text:
+            text = text.replace("{$DEFINE DYNLINK}", "{$DEFINE STATICLINK_OGGVORBIS}")
+        (dest / name).write_text(text)
+    return dest
