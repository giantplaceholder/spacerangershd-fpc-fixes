+def fetch_sdl2_mingw(work: Path) -> Path:
+    import urllib.request, zipfile
+    dest = work / 'sdl2-mingw'
+    marker = dest / '.version'
+    version = '2.30.2'
+    tree = dest / f'SDL2-{version}' / 'x86_64-w64-mingw32'
+    if marker.is_file() and marker.read_text().strip() == version and tree.is_dir():
+        return tree
+    dest.mkdir(parents=True, exist_ok=True)
+    archive = work / f'SDL2-devel-{version}-mingw.zip'
+    url = f'https://github.com/libsdl-org/SDL/releases/download/release-{version}/SDL2-devel-{version}-mingw.zip'
+    if not archive.is_file():
+        print(f'Downloading {url}…', flush=True)
+        urllib.request.urlretrieve(url, archive)
+    with zipfile.ZipFile(archive) as zf: zf.extractall(dest)
+    if not tree.is_dir():
+        roots = list(dest.glob('SDL2-*'))
+        if not roots: raise FileNotFoundError('SDL2 mingw archive layout unexpected')
+        tree = roots[0] / 'x86_64-w64-mingw32'
+    if not tree.is_dir(): raise FileNotFoundError(tree)
+    marker.write_text(version)
+    return tree
