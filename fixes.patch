+def build_windows(release: bool, rebuild: bool = False) -> Path:
+    require_tool('cmake')
+    prefix = 'x86_64-w64-mingw32-'
+    for tool in ('gcc', 'g++', 'ld', 'strip', 'ar'):
+        if shutil.which(prefix + tool) is None:
+            raise FileNotFoundError(f'Missing {prefix}{tool}; install mingw-w64.')
+    work = desktop_directory(ROOT, 'windows', release)
+    libraries, units = (work / name for name in ('bin', 'units'))
+    for directory in (libraries, units):
+        directory.mkdir(parents=True, exist_ok=True)
+    mingw_gcc = Path(shutil.which(prefix + 'gcc'))
+    implib = work / 'lib'
+    implib.mkdir(parents=True, exist_ok=True)
+    deps = build_mingw_image_deps(work)
+    ov = build_mingw_ogg_vorbis(work)
+    build_windows_deps_dll(work, libraries)
+    windres = shutil.which(prefix + 'windres') or str(mingw_gcc)
+    libdir = deps / 'lib'
+    def first_a(*names):
+        for n in names:
+            cand = libdir / n
+            if cand.is_file():
+                return cand
+        for n in names:
+            hits = list(libdir.glob(n))
+            if hits:
+                return hits[0]
+        return None
+    zlib_a = first_a('libz.a', 'libzlibstatic.a', 'libzlib.a')
+    png_a = first_a('libpng16.a', 'libpng.a', 'libpng16_static.a')
+    jpeg_a = first_a('libjpeg.a', 'libturbojpeg.a')
+    if zlib_a is None:
+        raise FileNotFoundError(f'Static zlib archive not found under {libdir}')
+    # ld splits -L on spaces; keep link inputs on a path without parentheses.
+    link_dir = mingw_safe_dir(work) / "link"
+    link_dir.mkdir(parents=True, exist_ok=True)
+    for src in (implib / "libwindows_deps.dll.a", implib / "windows_deps.dll.a"):
+        if src.is_file():
+            shutil.copy2(src, link_dir / src.name)
+    if zlib_a.is_file():
+        shutil.copy2(zlib_a, link_dir / "libz.a")
+    native = build_okgf(work, release,
+        '-DCMAKE_SYSTEM_NAME=Windows', '-DCMAKE_SYSTEM_PROCESSOR=x86_64', f'-DCMAKE_C_COMPILER={mingw_gcc}',
+        f'-DCMAKE_RC_COMPILER={windres}', f'-DCMAKE_PREFIX_PATH={deps}',
+        f'-DCMAKE_FIND_ROOT_PATH={deps}',
+        '-DCMAKE_FIND_ROOT_PATH_MODE_PROGRAM=NEVER',
+        '-DCMAKE_FIND_ROOT_PATH_MODE_LIBRARY=BOTH',
+        '-DCMAKE_FIND_ROOT_PATH_MODE_INCLUDE=BOTH',
+        '-DCMAKE_FIND_LIBRARY_SUFFIXES=.a',
+        f'-DZLIB_LIBRARY={zlib_a}',
+        f'-DZLIB_INCLUDE_DIR={deps / "include"}',
+        '-DZLIB_USE_STATIC_LIBS=ON',
+        *([f'-DPNG_LIBRARY={png_a}', f'-DPNG_PNG_INCLUDE_DIR={deps / "include"}'] if png_a else []),
+        *([f'-DJPEG_LIBRARY={jpeg_a}', f'-DJPEG_INCLUDE_DIR={deps / "include"}'] if jpeg_a else []),
+        '-DCMAKE_C_FLAGS=-Wno-error -Wno-pedantic',
+        f'-DCMAKE_SHARED_LINKER_FLAGS=-static-libgcc -L{link_dir} -lwindows_deps -lz',
+        rebuild=rebuild)
+    dll_candidates = list(native.rglob('okgf.dll')) + list(native.rglob('libokgf.dll'))
+    if not dll_candidates:
