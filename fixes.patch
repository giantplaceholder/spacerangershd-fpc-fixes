+procedure MouseWindowToLogical(var X, Y: Integer);
+var
+  LX, LY: Single;
+  WW, WH, PixW, PixH: Integer;
+begin
+  if (LogicalWidth <= 0) or (LogicalHeight <= 0) then
+    Exit;
+  // SDL motion is already in logical pixels when RenderSetLogicalSize is set.
+  // Only convert values that are clearly in window/pixel space (past the
+  // backbuffer), otherwise clicks shift up-left.
+  if (X <= LogicalWidth) and (Y <= LogicalHeight) then
+    Exit;
+  if GameSDLRenderer <> nil then
+    if SDL_RenderWindowToLogical(GameSDLRenderer, X, Y, LX, LY) = 0 then
+    begin
+      X := Round(LX);
+      Y := Round(LY);
+      Exit;
+    end;
+  if GameSDLWindow = nil then
+    Exit;
+  SDL_GetWindowSize(GameSDLWindow, WW, WH);
+  PixW := 0;
+  PixH := 0;
+  SDL_GetWindowSizeInPixels(GameSDLWindow, PixW, PixH);
+  if PixW > WW then
+  begin
+    WW := PixW;
+    WH := PixH;
+  end;
+  if WW > 0 then
+    X := X * LogicalWidth div WW;
+  if WH > 0 then
+    Y := Y * LogicalHeight div WH;
+end;
+
+
+procedure GameOutputSize(out W, H: Integer);
+var
+  WW, WH, PW, PH, OW, OH: Integer;
+begin
+  W := 0;
+  H := 0;
+  WW := 0;
+  WH := 0;
+  PW := 0;
+  PH := 0;
+  OW := 0;
+  OH := 0;
+  if GameSDLWindow <> nil then
+  begin
+    SDL_GetWindowSize(GameSDLWindow, WW, WH);
+    SDL_GetWindowSizeInPixels(GameSDLWindow, PW, PH);
+  end;
+  if GameSDLRenderer <> nil then
+    SDL_GetRendererOutputSize(GameSDLRenderer, OW, OH);
+  W := WW;
+  H := WH;
+  if PW > W then
+  begin
+    W := PW;
+    H := PH;
+  end;
+  if OW > W then
+  begin
+    W := OW;
+    H := OH;
+  end;
+end;
+
+function IntegerScaleFits(BufW, BufH, OutW, OutH: Integer): Boolean;
+begin
+  Result :=
+      (BufW > 0) and (BufH > 0) and (OutW > 0) and (OutH > 0)
+          and (OutW mod BufW = 0) and (OutH mod BufH = 0)
+          and (OutW div BufW >= 2);
+end;
+
+procedure ApplyIntegerScale;
+var
+  WinW, WinH, PixW, PixH: Integer;
+begin
+  if GameSDLRenderer = nil then
+    Exit;
+  WinW := 0;
+  WinH := 0;
+  PixW := 0;
+  PixH := 0;
+  if GameSDLWindow <> nil then
+  begin
+    SDL_GetWindowSize(GameSDLWindow, WinW, WinH);
+    SDL_GetWindowSizeInPixels(GameSDLWindow, PixW, PixH);
+  end;
+  // Any integer multiple: 1280x720 on 2560x1440, 1024x768 on 2048x1536,
+  // 1920x1080 on 3840x2160, 3x, etc. Points or pixels, whichever divides.
+  GameIntegerScaled :=
+      (not GameWindowed)
+          and (IntegerScaleFits(LogicalWidth, LogicalHeight, PixW, PixH)
+              or IntegerScaleFits(LogicalWidth, LogicalHeight, WinW, WinH));
+  if GameIntegerScaled then
+    SDL_RenderSetIntegerScale(GameSDLRenderer, 1)
+  else
+    SDL_RenderSetIntegerScale(GameSDLRenderer, 0);
+end;
+
+function WindowPixelScale: Double;
+var
+  WW, WH, PW, PH: Integer;
+begin
+  Result := 1;
+  if GameSDLWindow = nil then
+    Exit;
+  SDL_GetWindowSize(GameSDLWindow, WW, WH);
+  PW := 0;
+  PH := 0;
+  SDL_GetWindowSizeInPixels(GameSDLWindow, PW, PH);
+  if (WW > 0) and (PW > 0) then
+    Result := PW / WW;
+  if Result < 0.5 then
+    Result := 1;
+end;
